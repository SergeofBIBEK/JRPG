; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JRPG"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://scripts/global/event_service.gd"
ItemManager="*res://scripts/global/item_manager.gd"
PartyManager="*res://scripts/global/party_manager.gd"
SaveManager="*res://scripts/global/save_manager.gd"
BattleManager="*res://scripts/global/battle_manager.gd"
QuestManager="*res://scripts/global/quest_manager.gd"
AudioManager="*res://scripts/global/audio_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

